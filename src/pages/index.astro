---
import BaseLayout from '../layouts/BaseLayout.astro'
import { TOOLS } from '../lib/tools'
import { createSoftwareApplicationSchema } from '../lib/schema'
import { ToolDirectory } from '../components/layout/ToolDirectory'

const featured = TOOLS.find((t) => t.available)
const schema = [
  createSoftwareApplicationSchema({
    name: 'rechner.tools',
    description:
      'Deutsche Rechner für Freiberufler, Angestellte und Familien — Stundensatz, Brutto-Netto, Elterngeld und mehr.',
    url: 'https://rechner.tools',
  }),
]
---

<BaseLayout
  title="rechner.tools — Deutsche Rechner für alle Lebenslagen"
  description="Kostenlose, präzise Rechner für Freiberufler, Angestellte und Familien. Stundensatz, Brutto-Netto, Elterngeld und mehr."
  canonical="https://rechner.tools"
  schema={schema}
>
  <div class="min-h-screen">
    <!-- Nav -->
    <nav class="sticky top-0 z-30 border-b border-white/70 bg-white/80 backdrop-blur-xl">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <span class="flex items-center gap-2 font-display text-[1.1rem] font-bold tracking-tight text-ink">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-surface-dark text-sm text-white shadow-sm">rt</span>
          rechner.tools
        </span>
        <div class="hidden items-center gap-1.5 overflow-hidden md:flex">
          {TOOLS.filter(t => t.available).slice(0, 5).map(tool => (
            <a href={tool.slug} class="whitespace-nowrap rounded-full px-3 py-2 text-[13px] font-medium text-ink-muted hover:bg-surface-soft hover:text-ink">
              {tool.title.replace('-Rechner', '').replace('Rechner', '').trim()}
            </a>
          ))}
          <a href="/" class="whitespace-nowrap rounded-full bg-accent-light px-3 py-2 text-[13px] font-semibold text-accent-strong hover:bg-accent hover:text-white">
            Alle Rechner →
          </a>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-6xl px-3 pb-12 pt-5 sm:px-6 sm:pt-7">
      <div class="mb-4 overflow-hidden rounded-[18px] border border-white/70 bg-white/82 shadow-[0_24px_70px_rgba(38,45,40,0.10)] backdrop-blur sm:rounded-[24px]">
      <!-- Hero -->
      <div class="relative overflow-hidden border-b border-border px-5 pb-8 pt-9 sm:px-10 sm:pb-10 sm:pt-11">
        <div class="absolute inset-x-0 top-0 h-1 bg-[linear-gradient(90deg,#168a5a,#d69d2f,#168a5a)]"></div>
        <p class="inline-flex rounded-full bg-accent-light px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] text-accent-strong">Deutsche Rechner</p>
        <div class="mt-5 grid gap-7 lg:grid-cols-[minmax(0,1fr)_320px] lg:items-end">
          <div>
            <h1 class="max-w-3xl font-display text-4xl font-bold leading-tight tracking-tight text-ink sm:text-6xl">
              Rechnen, entscheiden, weitermachen.
            </h1>
            <p class="mt-4 max-w-2xl text-base leading-7 text-ink-muted">
              Kostenlose Rechner für Gehalt, Arbeit, Familie und Alltag. Schnell genug für eine erste Antwort, transparent genug für die nächste Entscheidung.
            </p>
          </div>
          <div class="grid grid-cols-1 gap-2 rounded-2xl border border-border bg-surface-elevated p-2 min-[420px]:grid-cols-3 lg:grid-cols-1">
            <div class="min-w-0 rounded-xl bg-white px-4 py-3.5 shadow-sm">
              <span class="font-display text-2xl font-bold leading-none text-ink">{TOOLS.filter(t => t.available).length}</span>
              <p class="mt-1.5 text-[11px] leading-4 text-ink-muted">aktive Rechner</p>
            </div>
            <div class="min-w-0 rounded-xl bg-white px-4 py-3.5 shadow-sm">
              <span class="font-display text-2xl font-bold leading-none text-ink">0</span>
              <p class="mt-1.5 text-[11px] leading-4 text-ink-muted">Anmeldung</p>
            </div>
            <div class="min-w-0 rounded-xl bg-white px-4 py-3.5 shadow-sm">
              <span class="block font-display text-2xl font-bold leading-none text-ink">Aktuell</span>
              <p class="mt-1.5 text-[11px] leading-4 text-ink-muted">Stand 2026</p>
            </div>
          </div>
        </div>
        {featured && (
          <div class="mt-6">
            <a
              href={featured.slug}
              class="inline-flex min-h-11 items-center gap-2 rounded-xl bg-accent px-4 py-2.5 text-sm font-semibold text-white shadow-[0_12px_28px_rgba(22,138,90,0.22)] transition-colors hover:bg-accent-mid focus:outline-none focus-visible:ring-2 focus-visible:ring-accent/20"
            >
              {featured.title} starten
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        )}
      </div>

      <!-- Live Tools & Search -->
      <div class="border-t border-border px-5 pb-8 pt-7 sm:px-10">
        <ToolDirectory tools={TOOLS} featured={featured} client:load />
      </div>
      </div> <!-- end bg-surface-card -->
    </main>

    <!-- Footer -->
    <footer class="mx-auto mt-4 max-w-6xl px-4 pb-8 sm:px-6">
      <div class="flex flex-col gap-3 rounded-2xl border border-white/70 bg-white/70 px-6 py-5 shadow-[0_14px_40px_rgba(38,45,40,0.06)] backdrop-blur sm:flex-row sm:items-center sm:justify-between">
        <div>
          <span class="font-display font-bold text-sm text-ink">rechner.tools</span>
          <div class="mt-1.5 flex gap-4">
            <a href="/impressum" class="text-sm text-ink-muted hover:text-accent transition-colors">Impressum</a>
            <a href="/datenschutz" class="text-sm text-ink-muted hover:text-accent transition-colors">Datenschutz</a>
          </div>
        </div>
        <span class="font-mono text-[11px] text-ink-faint">Alle Angaben ohne Gewähr · {new Date().getFullYear()}</span>
      </div>
    </footer>
  </div>
</BaseLayout>
